NODE_ENV=development
COMPOSE_PROJECT_NAME=acct
# Postgres
POSTGRES_USER=apxnet
POSTGRES_PASSWORD=apxnet_strong_pw_123
POSTGRES_DB=apxnet_accounts
DATABASE_URL=postgres://apxnet:apxnet_strong_pw_123@db:5432/apxnet_accounts

# Backend (5100 series — 5100 taken by NAS, using 5101)
PORT=5101
JWT_ACCESS_SECRET=dev_access_secret_change_me_32chars_min_abc123XYZ789
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_32chars_min_xyz987ABC321
ACCESS_TOKEN_TTL=15m
# Session length = how long a user stays logged in without logging in again.
# Sliding: renewed on every refresh/visit, so active users never get kicked out.
# Ends only on explicit logout, password change, or suspension.
REFRESH_TOKEN_TTL_DAYS=365

# Seed admin — THE single admin for profile-admin + nas-admin
SEED_ADMIN_EMAIL=control@apxnet.lab
SEED_ADMIN_PASSWORD=control

# Service key for NAS backend -> account backend server-to-server sync
# MUST match ACCOUNT_SERVICE_KEY in NAS .env
ACCOUNT_SERVICE_KEY=cbbc4226deb6a901e46243f90a4418e4a95aa995fffcf6942ecb6425126e689a

# Frontend public API URL (browser -> backend). LAN IP + Tailscale IP both work since backend binds 0.0.0.0.
# NOTE: in the browser the frontend calls `<page host>:<port from this URL>` so
# auth cookies are always same-host as the page — no matter whether you open the
# UI via LAN IP, Tailscale IP, localhost or a DNS name. Set NEXT_PUBLIC_API_SAME_HOST=0
# to pin requests to the host below instead (only if the API lives elsewhere).
# For LAN browsers:
NEXT_PUBLIC_API_URL=http://192.168.0.127:5101
# For Tailscale / global browsers, use http://100.108.126.45:5101 instead (see README).

# CSRF allowlist for the backend origin guard (comma-separated origins or hostnames).
# Only needed if your UI is served from a *different site* than the API.
# ALLOWED_ORIGINS=http://other-box:3102,apps.example.com

# Ports on host (frontend = 31xx, backend = 51xx)
BACKEND_PORT=5101
USER_PORT=3102
ADMIN_PORT=3103


